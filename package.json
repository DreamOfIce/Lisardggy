{
  "name": "yggdrasil-server",
  "version": "0.1.0",
  "description": "Yggdrasil Server Written in TypeScript",
  "keywords": [
    "minecraft",
    "yggdrasil"
  ],
  "homepage": "https://github.com/DreamOfIce/YggdrasilServer#readme",
  "bugs": {
    "url": "https://github.com/DreamOfIce/YggdrasilServer/issues"
  },
  "license": "MIT",
  "author": "DreamOfIce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamOfIce/YggdrasilServer.git"
  },
  "bin": "bin.js",
  "files": [
    "dist",
    "bin.js"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "cosmiconfig": "^10.0.1",
    "cosmokit": "^1.8.1",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "lowdb": "^7.0.1",
    "pino-prettier": "3.0.1-dev",
    "pino-roll": "^4.0.0",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.5.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino": "^10.3.1",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "nano-staged": {
    "*": "pnpm fmt --no-error-on-unmatched-pattern",
    "*.{c,m}?{js,ts}": "pnpm lint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
