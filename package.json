{
  "name": "yggdrasil-server",
  "version": "0.1.0",
  "description": "Yggdrasil Server Written in TypeScript",
  "keywords": [
    "minecraft",
    "yggdrasil"
  ],
  "homepage": "https://github.com/DreamOfIce/YggdrasilServer#readme",
  "bugs": {
    "url": "https://github.com/DreamOfIce/YggdrasilServer/issues"
  },
  "license": "MIT",
  "author": "DreamOfIce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamOfIce/YggdrasilServer.git"
  },
  "bin": "bin.js",
  "files": [
    "dist",
    "bin.js"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "@fastify/error": "^4.2.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/reply-from": "^12.6.5",
    "@lukeed/ms": "^2.0.2",
    "@node-rs/argon2": "^2.2.1",
    "cac": "^7.0.0",
    "cosmiconfig": "^10.0.1",
    "cosmokit": "^1.8.1",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-schemastery": "1.1.6",
    "ipaddr.js": "^2.5.0",
    "lowdb": "^7.0.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "schemastery": "^3.18.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino": "^10.3.1",
    "release-it": "^21.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "nano-staged": {
    "*": "pnpm fmt --no-error-on-unmatched-pattern",
    "*.{c,m}?{js,ts}": "pnpm lint"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "pnpm@12.8.2"
}
